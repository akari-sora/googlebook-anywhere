 namespace {
 
+/* Keep writes bounded without longjmp across C++ stack objects. */
+struct BoundedDestination {
+	jpeg_destination_mgr manager;
+	JOCTET *data;
+	size_t capacity;
+	bool overflow;
+	bool switched;
+	JOCTET discard[4096];
+};
+
+void initBoundedDestination(j_compress_ptr cinfo)
+{
+	auto *dest = reinterpret_cast<BoundedDestination *>(cinfo->dest);
+	dest->manager.next_output_byte = dest->data;
+	dest->manager.free_in_buffer = dest->capacity;
+	dest->overflow = false;
+	dest->switched = false;
+}
+
+boolean discardOverflow(j_compress_ptr cinfo)
+{
+	auto *dest = reinterpret_cast<BoundedDestination *>(cinfo->dest);
+	dest->overflow = dest->switched;
+	dest->switched = true;
+	dest->manager.next_output_byte = dest->discard;
+	dest->manager.free_in_buffer = sizeof(dest->discard);
+	return TRUE;
+}
+
+void finishBoundedDestination(j_compress_ptr cinfo)
+{
+	auto *dest = reinterpret_cast<BoundedDestination *>(cinfo->dest);
+	if (dest->switched && dest->manager.free_in_buffer != sizeof(dest->discard))
+		dest->overflow = true;
+}
