+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+namespace libcamera {
+
+/* Integer arithmetic retains the sensor's fractional frame period. */
+inline bool frameDuration(int64_t width, int64_t height, int64_t hblank,
+                          int64_t pixelRate, int64_t vblank, int64_t *duration)
+{
+	if (!duration || width <= 0 || height <= 0 || hblank < 0 ||
+	    vblank < 0 || pixelRate <= 0 || width > UINT32_MAX || height > UINT32_MAX ||
+	    hblank > INT32_MAX || vblank > INT32_MAX)
+		return false;
+	__int128 clocks = (__int128(width) + hblank) * (__int128(height) + vblank);
+	__int128 us = (clocks * 1000000 + pixelRate / 2) / pixelRate;
+	if (us <= 0 || us > std::numeric_limits<int64_t>::max())
+		return false;
+	*duration = static_cast<int64_t>(us);
+	return true;
+}
+
+inline bool fixedFrameTiming(int64_t width, int64_t height, int64_t hblank,
+                             int64_t pixelRate, int64_t minimum, int64_t maximum,
+                             uint64_t step, int32_t *vblank, int64_t *duration)
+{
+	if (!vblank || !duration || width <= 0 || height <= 0 || hblank < 0 ||
+	    pixelRate <= 0 || width > UINT32_MAX || height > UINT32_MAX ||
+	    hblank > INT32_MAX || minimum < 0 || maximum < minimum ||
+	    maximum > std::numeric_limits<int32_t>::max() || !step ||
+	    step > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()))
+		return false;
+	__int128 lines = __int128(pixelRate) / (30 * (__int128(width) + hblank));
+	__int128 limit = lines - height;
+	if (limit < minimum)
+		return false;
+	int64_t upper = limit > maximum ? maximum : static_cast<int64_t>(limit);
+	int64_t selected = minimum + (upper - minimum) / static_cast<int64_t>(step) * static_cast<int64_t>(step);
+	if (!frameDuration(width, height, hblank, pixelRate, selected, duration))
+		return false;
+	*vblank = static_cast<int32_t>(selected);
+	return true;
+}
+
