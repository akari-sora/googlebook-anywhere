+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+/* Match the HAL/CTS nominal-integer tolerance without changing durations. */
+inline unsigned int nominalMaxFps(int64_t minimumNs, bool fixed)
+{
+	return static_cast<unsigned int>(std::floor(1e9 / minimumNs + (fixed ? 0.05 : 0.0)));
+}
+
+inline int32_t nominalMinFps(int64_t maximumNs, int32_t maxFps, bool fixedMaximum)
+{
+	const double fps = 1e9 / maximumNs;
+	int32_t minimum = std::ceil(fps);
+	if (fixedMaximum && maxFps > 0 && minimum > maxFps && fps <= maxFps + 0.05)
+		minimum = maxFps;
+	return minimum;
+}
