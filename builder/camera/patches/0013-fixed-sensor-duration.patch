+int SimpleCameraData::configureFixedFrameDuration()
+{
+	fixedFrameDuration_ = 0;
+	fixedVblank_ = -1;
+	if (!swIsp_ || sensor_->model() != "ov2740")
+		return 0;
+
+	V4L2Subdevice *dev = sensor_->device();
+	dev->updateControlInfo();
+	const auto *info = dev->controlInfo(V4L2_CID_VBLANK);
+	if (!info || info->type != V4L2_CTRL_TYPE_INTEGER ||
+	    (info->flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY |
+			    V4L2_CTRL_FLAG_INACTIVE | V4L2_CTRL_FLAG_GRABBED)))
+		return -ENOTSUP;
+
+	IPACameraSensorInfo sensorInfo{};
+	if (sensor_->sensorInfo(&sensorInfo))
+		return -ENOTSUP;
+	static constexpr uint32_t ids[] = { V4L2_CID_HBLANK, V4L2_CID_PIXEL_RATE, V4L2_CID_VBLANK };
+	ControlList values = sensor_->getControls(ids);
+	if (values.empty())
+		return -ENOTSUP;
+	int32_t hblank = values.get(V4L2_CID_HBLANK).get<int32_t>();
+	int64_t pixelRate = values.get(V4L2_CID_PIXEL_RATE).get<int64_t>();
+	int32_t vblank;
+	int64_t duration;
+	if (!fixedFrameTiming(sensorInfo.outputSize.width, sensorInfo.outputSize.height,
+			      hblank, pixelRate, info->minimum, info->maximum, info->step,
+			      &vblank, &duration))
+		return -ENOTSUP;
+	ControlList set(sensor_->controls());
+	set.set(V4L2_CID_VBLANK, vblank);
+	if (sensor_->setControls(&set))
+		return -EIO;
+	fixedVblank_ = vblank;
+	fixedFrameDuration_ = duration;
+	if (verifyFixedFrameDuration()) {
+		fixedFrameDuration_ = 0;
+		return -EIO;
+	}
+	dev->updateControlInfo();
+	ControlInfoMap::Map map;
+	for (const auto &control : controlInfo_)
+		map.emplace(control.first, control.second);
+	map[&controls::FrameDurationLimits] = ControlInfo(duration, duration, duration);
+	controlInfo_ = ControlInfoMap(std::move(map), controls::controls);
+	return 0;
+}
+
+int SimpleCameraData::verifyFixedFrameDuration()
+{
+	if (!fixedFrameDuration_)
+		return 0;
+	static constexpr uint32_t ids[] = { V4L2_CID_HBLANK, V4L2_CID_PIXEL_RATE, V4L2_CID_VBLANK };
+	ControlList values = sensor_->getControls(ids);
+	IPACameraSensorInfo info{};
+	if (values.empty() || sensor_->sensorInfo(&info))
+		return -EIO;
+	int64_t duration;
+	if (values.get(V4L2_CID_VBLANK).get<int32_t>() != fixedVblank_ ||
+	    !frameDuration(info.outputSize.width, info.outputSize.height,
+			   values.get(V4L2_CID_HBLANK).get<int32_t>(),
+			   values.get(V4L2_CID_PIXEL_RATE).get<int64_t>(),
+			   fixedVblank_, &duration) || duration != fixedFrameDuration_)
+		return -EIO;
+	return 0;
+}
