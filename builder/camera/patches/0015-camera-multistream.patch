+/* GNU build IDs identify the exact ABI supported below, not file authenticity. */
+struct BuildIdMatch {
+	uintptr_t address;
+	const uint8_t *expected;
+	size_t expectedLength;
+	bool matched = false;
+};
+
+int matchLoadedBuildId(dl_phdr_info *info, size_t, void *data)
+{
+	auto *query = static_cast<BuildIdMatch *>(data);
+	bool contains = false;
+	for (ElfW(Half) i = 0; i < info->dlpi_phnum; ++i) {
+		const auto &ph = info->dlpi_phdr[i];
+		const uintptr_t base = info->dlpi_addr + ph.p_vaddr;
+		if (ph.p_vaddr <= UINTPTR_MAX - info->dlpi_addr &&
+		    ph.p_type == PT_LOAD && query->address >= base &&
+		    query->address - base < ph.p_memsz)
+			contains = true;
+	}
+	if (!contains)
+		return 0;
+	for (ElfW(Half) i = 0; i < info->dlpi_phnum; ++i) {
+		const auto &ph = info->dlpi_phdr[i];
+		if (ph.p_type != PT_NOTE || ph.p_memsz > 65536 ||
+		    ph.p_vaddr > UINTPTR_MAX - info->dlpi_addr)
+			continue;
+		const uintptr_t note = info->dlpi_addr + ph.p_vaddr;
+		bool readable = false;
+		for (ElfW(Half) j = 0; j < info->dlpi_phnum; ++j) {
+			const auto &load = info->dlpi_phdr[j];
+			if (load.p_type != PT_LOAD || !(load.p_flags & PF_R) ||
+			    load.p_vaddr > UINTPTR_MAX - info->dlpi_addr)
+				continue;
+			const uintptr_t base = info->dlpi_addr + load.p_vaddr;
+			if (note >= base && note - base <= load.p_memsz &&
+			    ph.p_memsz <= load.p_memsz - (note - base))
+				readable = true;
+		}
+		if (!readable)
+			continue;
+		const auto *bytes = reinterpret_cast<const uint8_t *>(note);
+		size_t offset = 0, length = ph.p_memsz;
+		while (length - offset >= sizeof(ElfW(Nhdr))) {
+			ElfW(Nhdr) header;
+			memcpy(&header, bytes + offset, sizeof(header));
+			offset += sizeof(header);
+			if (header.n_namesz > length - offset || header.n_namesz > 65532 ||
+			    header.n_descsz > 65532)
+				break;
+			const size_t nameSize = (header.n_namesz + 3u) & ~3u;
+			const size_t descSize = (header.n_descsz + 3u) & ~3u;
+			if (nameSize > length - offset || descSize > length - offset - nameSize)
+				break;
+			if (header.n_type == NT_GNU_BUILD_ID && header.n_namesz == 4 &&
+			    !memcmp(bytes + offset, "GNU\0", 4) &&
+			    header.n_descsz == query->expectedLength &&
+			    !memcmp(bytes + offset + nameSize, query->expected, query->expectedLength)) {
+				query->matched = true;
+				return 1;
+			}
+			offset += nameSize + descSize;
+		}
+	}
+	return 1;
+}
