+/*
+ * A CPU SoftISP only produces one native output.  When the JPEG source is
+ * the largest NV12 configuration, use that internal frame as the source for
+ * all smaller NV12 streams.  Leave other combinations untouched.
+ */
+bool consolidateJpegNv12(std::vector<Camera3StreamConfig> &configs,
+                         const camera3_stream_t *jpeg)
+{
+	if (!jpeg || configs.size() < 2)
+		return false;
+	auto source = std::find_if(configs.begin(), configs.end(),
+		[jpeg](const Camera3StreamConfig &c) {
+			return c.streams.size() == 1 &&
+			       c.streams[0].stream == jpeg &&
+			       c.streams[0].type == CameraStream::Type::Internal;
+		});
+	if (source == configs.end() || source->config.pixelFormat != formats::NV12)
+		return false;
+	const Size sourceSize = source->config.size;
+	for (const auto &c : configs) {
+		if (c.config.pixelFormat != formats::NV12 ||
+		    c.config.size.width > sourceSize.width ||
+		    c.config.size.height > sourceSize.height)
+			return false;
+	}
+	Camera3StreamConfig result = *source;
+	result.streams[0].stream->usage |= GRALLOC_USAGE_HW_CAMERA_WRITE |
+					    GRALLOC_USAGE_SW_READ_OFTEN;
+	for (const auto &c : configs) {
+		if (&c == &*source)
+			continue;
+		for (const auto &entry : c.streams) {
+			entry.stream->usage |= GRALLOC_USAGE_SW_WRITE_OFTEN;
+			result.streams.push_back({ entry.stream, CameraStream::Type::Mapped });
+		}
+	}
+	configs.clear();
+	configs.push_back(std::move(result));
+	return true;
+}
